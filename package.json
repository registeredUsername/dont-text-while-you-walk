{
  "name": "dont-text-while-you-walk",
  "version": "0.1.0",
  "private": true,
  "description": "Runner mobile : gérer son téléphone et la rue en même temps.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "phaser": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-qrcode": "^0.4.1",
    "vitest": "^5.1.0"
  }
}
